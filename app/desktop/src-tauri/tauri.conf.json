{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xuanshu",
  "version": "1.0.0",
  "identifier": "com.nihaixia.desktop",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "玄枢 · 传统智慧 AI 工作台",
        "width": 1280,
        "height": 840,
        "minWidth": 420,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "resources": {
      "binaries/nihaixia-node": "binaries/nihaixia-node",
      "binaries/sea.cjs": "binaries/sea.cjs",
      "knowledge/": "knowledge/",
      "scripts/": "scripts/",
      "web-dist/": "web-dist/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
