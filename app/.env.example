# ============ 玄枢 · 部署配置 ============
# 复制为 .env 并填写，切勿提交 .env 到 git（并执行 chmod 600 .env）

# —— 必填 ——
# 你的 LLM API Key（DeepSeek / OpenAI 兼容服务均可）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 用于签名会话令牌的随机密钥（至少 32 字符，可用 openssl rand -hex 32 生成）
APP_SECRET=please-generate-a-long-random-string

# —— 管理员（重要）——
# 管理员账号由这里指定：填你在站点注册的用户名，该账号即为唯一管理员。
# 留空则沿用老规则（第一个注册的用户自动成为管理员），建议尽早明确指定。
# 修改后需重启容器：docker compose up -d
ADMIN_USERNAME=

# —— 用户注册（可选）——
# 是否允许新用户自行注册：true 开放 / false 关闭（关闭后只能由管理员在后台建号）。
# 不设置时默认开放（兼容既有部署）；后台「站点设置」里在线切换后以数据库为准。
# 注意：数据库为空时首次仍允许注册，用于创建初始账号。
# REGISTRATION_ENABLED=true

# —— 站点访问 ——
# 域名：留空或 localhost 走 HTTP；填写真实域名自动启用 HTTPS（Let's Encrypt）
# 用宝塔/Nginx 反代时 Caddy 只监听内网，DOMAIN 必须填「:80」——
# 填 localhost 会让 Caddy 按站点自动启用 HTTPS，把所有请求 308 跳到 https，反代后端拿不到响应。
DOMAIN=:80

# HTTPS 部署时保持 true；用宝塔反代 + 内网 HTTP 时设为 false
COOKIE_SECURE=true

# —— 安全（一般不用改）——
# 反向代理信任：docker compose 部署固定在 Caddy 之后，保持 1（只信任紧邻一跳）。
# 桌面版/直连部署请留空或设 false —— 设 true 会信任客户端伪造的 X-Forwarded-For，
# 使登录限流与失败节流完全失效（攻击者可无限次爆破口令）。
# TRUST_PROXY=1

# 跨域白名单（逗号分隔）。默认留空 = 关闭跨域（同源访问不受影响，最安全）。
# 只有在「前端与后端不同域」时才填写，例如：CORS_ORIGIN=https://tcm.example.com
# CORS_ORIGIN=

# 登录失败节流（账号维度，防暴力破解；IP 可伪造，账号维度不可）
# LOGIN_FAIL_THRESHOLD=5
# LOGIN_LOCK_BASE_MS=30000
# LOGIN_LOCK_MAX_MS=900000

# 是否在日志中记录每个 HTTP 请求（默认关；开启会把访问细节写进日志）
# LOG_REQUESTS=false

# —— 一键更新（可选，按需启用）——
# 生成：openssl rand -hex 32
# UPDATER_TOKEN=
# UPDATER_URL=http://updater:8765

# —— 网页版 DeepSeek 直连（0 Token，可选）——
# 一般不用填：在管理后台「模型设置 → 粘贴登录凭证」保存即可（存数据库）。
# 需要自动化部署时可在此预置（userToken 来自已登录 chat.deepseek.com 的 localStorage）。
# DSWEB_USER_TOKEN=

# —— LLM 服务（默认 DeepSeek，也可在管理面板里改）——
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 对外端口（默认 80/443；用宝塔反代时可改为 127.0.0.1 上的端口如 18080）
# HTTP_PORT=18080
# HTTPS_PORT=18443

# 日志级别 info | warn | error
# LOG_LEVEL=info
