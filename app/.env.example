# ============ 倪海厦中医问诊 · 部署配置 ============
# 复制为 .env 并填写，切勿提交 .env 到 git

# —— 必填 ——
# 你的 LLM API Key（DeepSeek / OpenAI 兼容服务均可）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 用于签名会话令牌的随机密钥（至少 32 字符，可用 openssl rand -hex 32 生成）
APP_SECRET=please-generate-a-long-random-string

# —— 选填 ——
# 域名：留空或 localhost 走 HTTP；填写真实域名自动启用 HTTPS（Let's Encrypt）
DOMAIN=localhost

# LLM 服务地址与模型（默认 DeepSeek）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 对外端口（默认 80/443，可用其他端口映射）
# HTTP_PORT=80
# HTTPS_PORT=443

# 日志级别 info | warn | error
# LOG_LEVEL=info
